# ===== Obligatorias =====
# Base de datos: en Railway agrega un servicio Postgres y pon aquí ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Dirección pública de la app (la que da Railway o tu dominio). Va en los QR y en los mensajes.
URL_PUBLICA=https://app-traslados-production.up.railway.app
# Frase larga al azar para firmar las sesiones.
SECRETO_SESION=
# Clave para entrar al tablero de administración.
CLAVE_ADMIN=
# Tu WhatsApp (con 57): aquí llegan las alertas.
TELEFONO_ADMIN=573507549638

# ===== Modo prueba =====
# on = barra arriba para saltar entre las 4 pantallas con un clic, entrar sin PIN y datos de ejemplo.
# Ponlo en off antes de dar el enlace a anfitriones y conductores reales.
MODO_PRUEBA=on
# Carga anfitriones, conductores y viajes de ejemplo si la base está vacía (por defecto igual que MODO_PRUEBA).
SEMILLA_DEMO=
MARCA=Llegá

# ===== Pago (Wompi) — sin esto el pago es simulado =====
# Wompi → Desarrolladores → Llaves. Las de prueba empiezan por pub_test_, las reales por pub_prod_.
WOMPI_LLAVE_PUBLICA=
WOMPI_SECRETO_INTEGRIDAD=
WOMPI_SECRETO_EVENTOS=

# ===== WhatsApp (Evolution API) — sin esto los mensajes solo quedan en el tablero =====
# Usa un número NUEVO, distinto al de la lavandería.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=
# Va al final de la URL del webhook: https://<app>/webhooks/whatsapp/<este secreto>
SECRETO_WEBHOOK_WHATSAPP=

# ===== Correo de confirmación (opcional, Resend) =====
RESEND_API_KEY=
CORREO_REMITENTE=

# Tareas automáticas cada minuto (ofertas, avisos, alertas). off solo para pruebas.
PROGRAMADOR=on
